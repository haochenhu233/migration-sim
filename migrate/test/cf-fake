#!/usr/bin/env bash
# cf-fake: a STATEFUL fake `cf curl` for testing apply offline. State lives in $CFFAKE_STATE (json).
#   cf-fake seed <waves.tsv>     build the initial world from a plan: spaces, redis instances,
#                                valkey plans, apps (STARTED, 1 instance), app<->redis bindings
#   cf curl PATH [-i] [-X M] [-H h] [-d body]    v3 subset used by migrate.sh (GET/POST/PATCH/DELETE)
#   CFFAKE_FAIL_GET=<path prefix>[,..] -> every GET under it is a 500 error document (API-error paths); a prefix ending
#                                in '$' matches the path exactly (e.g. .../processes/web$ leaves .../web/stats alone)
# Failure injection (env):
#   CFFAKE_FAIL_CREATE=<svc name>      the valkey create job FAILS
#   CFFAKE_CRASH=<app guid>            after a restart that app reports CRASHED instances
#   CFFAKE_STATS_FAIL=<app guid>       that app's /processes/web/stats answers an error document (404)
#   CFFAKE_STOPPED=<app guid[,..]>     those apps are STOPPED
#   CFFAKE_BROKEN=<app guid>:<r>[,..]  only r of that app's instances are RUNNING (the rest CRASHED), before and after any
#                                      restart -- an app broken BEFORE its wave (lab 2026-10-22)
#   CFFAKE_INSTANCES=<guid>=N[,..]     instance count per app (default 1)
#   CFFAKE_CREATE_POLLS=N              job polls before a create completes (default 2); a GET of the instance list WITH
#                                      service_plan_guids (the --max-inflight gate's) is one poll's worth for every pending create
#   CFFAKE_TOUCH=<file>:<n>            create <file> on the n-th such listing (a STOP file appearing while the gate waits)
#   CFFAKE_BIND_FAIL=<app guid>        binding create for that app FAILS (job); like CF, the binding record STAYS in state
#                                      'create failed' and a new bind for the pair is refused until it is deleted
#   CFFAKE_BIND_POLLS=N                job polls before a bind completes (default 1). A binding's last_operation.state follows
#                                      its job: 'in progress' until then; every GET of the bindings list counts as one poll
#                                      ("time passes" for a bind of a killed run that nobody polls)
#   CFFAKE_SHARED=<svc guid>           that instance is shared into one other space (relationships/shared_spaces)
#   CFFAKE_NO_INCLUDED=1               GET /v3/service_plans/<g>?include=service_offering answers without `included`
#   CFFAKE_FINISH_JOBS=1               "time passed": every pending job completes before this call (a job of a killed
#                                      run is never polled again, but the real broker finishes the create anyway)
#   CFFAKE_WRONG=<si name>:space|plan  GET of that instance reports another space (sp-other) or another plan
#   CFFAKE_HOLLOW=<service name>       the valkey for that service (named <name> or <name>-valkey-staged) is HOLLOW: CF has
#                                      it, the broker lost it (SBX 2026-10-20) -- rename works (CF only); bind creates a
#                                      binding in state 'create failed' and the job fails "deployment not found"; unbind
#                                      of such a binding fails the same way. DELETE ...?purge=true removes it + bindings.
#   CFFAKE_RENAME_FAIL=<si guid>:<name>[,..] PATCH of that instance TO that name is accepted but its job FAILS (name unchanged)
#   CFFAKE_NAMED=<app guid>:<name>[,..] that app resolves its service BY NAME from the VCAP_SERVICES it read at its LAST
#                                      restart (st['env'][app] = names bound then): CRASHED while that snapshot lacks
#                                      <name>; a later rename does not help until the app is restarted again
#                                      (plan-valkey-other) -- what provision-check must catch
# With SAFEFAKE_STATE set, seed and every create also write <dir>/<guid> = the instance name -- what the
# broker stores as instance_name at provision time, read back by safe-fake (name-sync's pre-check).
export CFFAKE_STATE="${CFFAKE_STATE:-/tmp/cffake.json}"
python3 - "$@" <<'PY'
import os, sys, json, csv, uuid, re, urllib.parse
S=os.environ['CFFAKE_STATE']
def load(): return json.load(open(S)) if os.path.exists(S) else None
def save(st): json.dump(st, open(S,'w'), indent=1)
def broker_stores(guid, name):   # Blacksmith writes instance_name into its own Vault at provision
    d=os.environ.get('SAFEFAKE_STATE')
    if d: os.makedirs(d, exist_ok=True); open(os.path.join(d, guid),'w').write(name+'\n')
args=sys.argv[1:]
if args and args[0]=='seed':
    rows=list(csv.DictReader(open(args[1]), delimiter='\t'))
    st={'spaces':{}, 'si':{}, 'plans':{}, 'apps':{}, 'bind':{}, 'jobs':{}, 'dep':{}, 'restarts':{}}
    for r in rows:
        sp=r['service_space']+'@'+r['service_org']; spg='sp-'+re.sub(r'[^a-z0-9]','',sp)[:12]
        st['spaces'][spg]={'name':r['service_space'],'org':r['service_org']}
        rp='plan-redis-'+r['valkey_plan']; vp='plan-valkey-'+r['valkey_plan']
        st['plans'][rp]={'name':r['valkey_plan'],'offering':'redis'}; st['plans'][vp]={'name':r['valkey_plan'],'offering':'valkey'}
        st['si'].setdefault(r['service_guid'],{'name':r['service'],'space':spg,'plan':rp,'last_op':{'type':'create','state':'succeeded'}}); broker_stores(r['service_guid'], r['service'])
        st['apps'].setdefault(r['app_guid'],{'name':r['app'],'space':spg,'state':'STARTED'})
        if 'no-binding' not in r['flags']:
            bg='b-'+r['app_guid'][:8]+'-'+r['service_guid'][:8]
            st['bind'][bg]={'app':r['app_guid'],'si':r['service_guid']}
    for g in os.environ.get('CFFAKE_STOPPED','').split(','):
        if g in st['apps']: st['apps'][g]['state']='STOPPED'
    save(st); print('seeded', len(st['si']), 'services', len(st['apps']), 'apps', len(st['bind']), 'bindings'); sys.exit()
if not args or args[0]!='curl': print('fake: only curl', file=sys.stderr); sys.exit(1)
st=load() or sys.exit('fake: not seeded')
if os.environ.get('CFFAKE_FINISH_JOBS'):
    for jg,j in st['jobs'].items():
        if j['n']<j['polls'] and not j['fail']:
            j['n']=j['polls']
            if j['kind'].startswith('create:') and j['kind'][7:] in st['si']: st['si'][j['kind'][7:]]['last_op']={'type':'create','state':'succeeded'}
path=None; method='GET'; body=''; inc=False; i=1
while i<len(args):
    a=args[i]
    if a=='-i': inc=True
    elif a=='-X': method=args[i+1]; i+=1
    elif a=='-H': i+=1
    elif a=='-d': body=args[i+1]; i+=1
    elif path is None: path=a
    i+=1
u=urllib.parse.urlparse(path); p=u.path; q=urllib.parse.parse_qs(u.query)
code=200; hdr={}; out=None
def err(c,title,detail): global code,out; code=c; out={'errors':[{'title':title,'detail':detail}]}
def job(kind, polls=1, fail=None):
    jg='job-'+uuid.uuid4().hex[:8]; st['jobs'][jg]={'kind':kind,'polls':polls,'n':0,'fail':fail}; return jg
def job_tick(jg):   # one poll's worth of time for that job; its answer (and the instance's last_operation once it is done)
    j=st['jobs'][jg]; j['n']+=1
    if j['n']>=j['polls']:
        if j['fail']:
            if j['kind'].startswith('create:') and j['kind'][7:] in st['si']: st['si'][j['kind'][7:]]['last_op']={'type':'create','state':'failed'}
            return {'guid':jg,'state':'FAILED','errors':[{'title':'CF-UnableToPerform','detail':j['fail']}]}
        if j['kind'].startswith('create:'): st['si'][j['kind'][7:]]['last_op']={'type':'create','state':'succeeded'}
        return {'guid':jg,'state':'COMPLETE','errors':[]}
    return {'guid':jg,'state':'PROCESSING','errors':[]}
def accepted(jg): global code; code=202; hdr['Location']='https://api.fake/v3/jobs/'+jg
def listing(res): return {'pagination':{'total_results':len(res),'next':None},'resources':res}
H=os.environ.get('CFFAKE_HOLLOW','')
def hollow(g): return bool(H) and g in st['si'] and st['si'][g]['plan'].startswith('plan-valkey-') and st['si'][g]['name'] in (H, H+'-valkey-staged')
NAMED={}
for kv in os.environ.get('CFFAKE_NAMED','').split(','):
    if ':' in kv: g,n=kv.split(':',1); NAMED[g]=n
def env_snapshot(ag): st.setdefault('env',{})[ag]=sorted({st['si'][b['si']]['name'] for b in st['bind'].values() if b['app']==ag and bind_state(b)=='succeeded' and b['si'] in st['si']})
def si_obj(g):
    s=st['si'][g]; sp=s['space']; pl=s['plan']; w=os.environ.get('CFFAKE_WRONG','')
    if s['last_op']['state']=='initial':   # the broker answers after CFFAKE_INITIAL_POLLS reads of the instance (default 1)
        s['seen']=s.get('seen',0)+1
        if s['seen']>=int(os.environ.get('CFFAKE_INITIAL_POLLS','1')): s['last_op']={'type':'create','state':'in progress'}
    if w==s['name']+':space': sp='sp-other'
    if w==s['name']+':plan': pl='plan-valkey-other'
    return {'guid':g,'name':s['name'],'last_operation':s['last_op'],'relationships':{'space':{'data':{'guid':sp}},'service_plan':{'data':{'guid':pl}}}}
SPACES=dict(st['spaces']); SPACES['sp-other']={'name':'other','org':'other-org'}
PLANS=dict(st['plans']); PLANS['plan-valkey-other']={'name':'cache-other','offering':'valkey'}
INST={}
for kv in os.environ.get('CFFAKE_INSTANCES','').split(','):
    if '=' in kv: g,n=kv.split('='); INST[g]=int(n)
BROKEN={}   # CFFAKE_BROKEN=<app guid>:<r>[,..]: only r of its instances RUNNING (the rest CRASHED), restarted or not -- broken BEFORE the wave
for kv in os.environ.get('CFFAKE_BROKEN','').split(','):
    if ':' in kv: g,n=kv.split(':'); BROKEN[g]=int(n)
fg=[x for x in os.environ.get('CFFAKE_FAIL_GET','').split(',') if x]   # CFFAKE_FAIL_GET=<path prefix>[,..]: every GET under it answers a 500 error document; 'x$' = exactly x
def bind_state(b):   # a binding's last_operation.state follows its job (in progress until polled out); 'failed' sticks
    if b.get('failed'): return 'failed'
    j=st['jobs'].get(b.get('job',''))
    if j is None: return 'succeeded'
    if j['n']<j['polls']: return 'in progress'
    return 'failed' if j['fail'] else 'succeeded'
if fg and method=='GET' and any((p==x[:-1]) if x.endswith('$') else p.startswith(x) for x in fg): err(500,'UnknownError','An unknown error occurred (fake CFFAKE_FAIL_GET)')
elif p=='/v3/info': out={'name':'cf-fake'}
elif p=='/v3/jobs/'+p[9:] and p.startswith('/v3/jobs/'):
    jg=p[9:]; j=st['jobs'].get(jg)
    if not j: err(404,'CF-ResourceNotFound','job')
    else:
        out=job_tick(jg)
elif p.startswith('/v3/service_plans/'):
    g=p.split('/')[3]; v=PLANS.get(g)
    if not v: err(404,'CF-ResourceNotFound','Service plan not found')
    else:
        out={'guid':g,'name':v['name'],'relationships':{'service_offering':{'data':{'guid':'off-'+v['offering']}}}}
        if 'service_offering' in q.get('include',[''])[0].split(',') and not os.environ.get('CFFAKE_NO_INCLUDED'): out['included']={'service_offerings':[{'guid':'off-'+v['offering'],'name':v['offering']}]}
elif p.startswith('/v3/spaces/'):
    g=p.split('/')[3]; v=SPACES.get(g)
    if not v: err(404,'CF-ResourceNotFound','Space not found')
    else: out={'guid':g,'name':v['name'],'relationships':{'organization':{'data':{'guid':'org-'+re.sub(r'[^a-z0-9]','',v['org'])}}}}
elif p.startswith('/v3/organizations/'):
    g=p.split('/')[3]; names={'org-'+re.sub(r'[^a-z0-9]','',v['org']):v['org'] for v in SPACES.values()}
    if g not in names: err(404,'CF-ResourceNotFound','Organization not found')
    else: out={'guid':g,'name':names[g]}
elif p=='/v3/service_plans':
    names=q['names'][0].split(',') if q.get('names') else None; off=q.get('service_offering_names',[''])[0]   # no names= -> every plan (of the offering), as on CF
    out=listing([{'guid':g,'name':v['name']} for g,v in st['plans'].items() if (names is None or v['name'] in names) and (not off or v['offering']==off)])
elif p=='/v3/service_instances' and method=='GET':
    bad=[k for k in q if k not in ('names','space_guids','guids','type','service_plan_guids','per_page','page')]
    if bad: err(400,'CF-BadQueryParameter',f"Unknown query parameter(s): '{','.join(bad)}'")
    else:
        # time passes: a real deploy advances whether or not anyone polls its job; here every instance LISTING is one
        # poll's worth for every pending create (the --max-inflight gate lists instead of polling jobs). CFFAKE_TOUCH=
        # <file>:<n> creates <file> on the n-th listing (a STOP file appearing while the gate waits).
        if q.get('service_plan_guids'):   # the gate's listing only (accept/leftover listings are by name and must not move time)
            st['lists']=st.get('lists',0)+1
            for jg,j in list(st['jobs'].items()):
                if j['kind'].startswith('create:') and j['n']<j['polls']: job_tick(jg)
            t=os.environ.get('CFFAKE_TOUCH','')
            if t and st['lists']==int(t.rsplit(':',1)[1]): open(t.rsplit(':',1)[0],'w').close()
        res=[si_obj(g) for g,s in st['si'].items() if (not q.get('names') or s['name'] in q['names'][0].split(',')) and (not q.get('space_guids') or s['space'] in q['space_guids'][0].split(','))]
        out=listing(res)
elif p=='/v3/service_instances' and method=='POST':
    b=json.loads(body); name=b['name']; sp=b['relationships']['space']['data']['guid']; pl=b['relationships']['service_plan']['data']['guid']
    if any(s['name']==name and s['space']==sp for s in st['si'].values()): err(422,'CF-UnprocessableEntity',f"The service instance name is taken: {name}")
    else:
        # like CF: the instance is 'initial' until a job worker has called the broker; a POST while another create is
        # still 'initial' is what reaches Blacksmith concurrently -> counted in st['overlap'] (must stay 0)
        if any(s['last_op']['state']=='initial' for s in st['si'].values()): st['overlap']=st.get('overlap',0)+1
        # creates alive (not yet succeeded/failed) at this POST, the new one included: the --max-inflight cap is asserted on its max
        alive=1+sum(1 for s in st['si'].values() if s['last_op']['type']=='create' and s['last_op']['state'] in ('initial','in progress'))
        st['maxinflight']=max(st.get('maxinflight',0), alive)
        g=str(uuid.uuid4()); st['si'][g]={'name':name,'space':sp,'plan':pl,'last_op':{'type':'create','state':'initial'},'seen':0}; broker_stores(g, name)
        fail=f"Service broker error: provision failed for {name}" if os.environ.get('CFFAKE_FAIL_CREATE')==name else None
        accepted(job('create:'+g, int(os.environ.get('CFFAKE_CREATE_POLLS','2')), fail))
elif p.startswith('/v3/service_instances/') and p.endswith('/relationships/shared_spaces'):
    g=p.split('/')[3]
    if g not in st['si']: err(404,'CF-ResourceNotFound','Service instance not found')
    else: out={'data':([{'guid':'sp-other'}] if os.environ.get('CFFAKE_SHARED')==g else []),'links':{}}
elif p.startswith('/v3/service_instances/'):
    g=p.split('/')[3]
    if g not in st['si']: err(404,'CF-ResourceNotFound','Service instance not found')
    elif method=='GET': out=si_obj(g)
    elif method=='PATCH':
        b=json.loads(body)
        if g+':'+b.get('name','') in os.environ.get('CFFAKE_RENAME_FAIL','').split(','): accepted(job('update:'+g, 1, 'Service broker error: rename refused (fake)'))
        else:
            if 'name' in b: st['si'][g]['name']=b['name']
            accepted(job('update:'+g))
    elif method=='DELETE':
        if q.get('purge',[''])[0]=='true':   # CF removes the instance and its bindings without calling the broker
            for bg in [k for k,b in st['bind'].items() if b['si']==g]: del st['bind'][bg]
            del st['si'][g]; code=204
        else: del st['si'][g]; accepted(job('delete'))
elif p=='/v3/service_credential_bindings' and method=='GET':
    bad=[k for k in q if k not in ('app_guids','service_instance_guids','type','names','guids','per_page','page')]
    if bad: err(400,'CF-BadQueryParameter',f"Unknown query parameter(s): '{','.join(bad)}'")
    else:
        sel=[(g,b) for g,b in st['bind'].items()
             if (not q.get('app_guids') or b['app'] in q['app_guids'][0].split(',')) and (not q.get('service_instance_guids') or b['si'] in q['service_instance_guids'][0].split(','))]
        res=[{'guid':g,'type':'app','last_operation':{'type':'create','state':bind_state(b)},'relationships':{'app':{'data':{'guid':b['app']}},'service_instance':{'data':{'guid':b['si']}}}} for g,b in sel]
        for g,b in sel:   # time passes: a listed binding's job advances one poll
            j=st['jobs'].get(b.get('job',''))
            if j is not None and j['n']<j['polls']: j['n']+=1
        out=listing(res)
elif p=='/v3/service_credential_bindings' and method=='POST':
    b=json.loads(body); ag=b['relationships']['app']['data']['guid']; sg=b['relationships']['service_instance']['data']['guid']
    if ag not in st['apps'] or sg not in st['si']: err(422,'CF-UnprocessableEntity','app or service instance not found')
    elif any(x['app']==ag and x['si']==sg for x in st['bind'].values()): err(422,'CF-UnprocessableEntity','The app is already bound to the service instance')
    elif hollow(sg):   # the binding record stays, in state create failed
        bg='b-'+uuid.uuid4().hex[:8]; st['bind'][bg]={'app':ag,'si':sg,'failed':True}
        accepted(job('bind', 1, f"bind could not be completed: Service broker error: failed to retrieve credentials: failed to get deployment VMs: deployment not found: valkey-cache-small-{sg}"))
    else:   # the record exists from the POST on; its state follows the job (CFFAKE_BIND_FAIL: the job fails, the record stays 'failed')
        bg='b-'+uuid.uuid4().hex[:8]; jg=job('bind', int(os.environ.get('CFFAKE_BIND_POLLS','1')), 'Service broker error: bind refused' if os.environ.get('CFFAKE_BIND_FAIL')==ag else None)
        st['bind'][bg]={'app':ag,'si':sg,'job':jg}; accepted(jg)
elif p.startswith('/v3/service_credential_bindings/') and method=='DELETE':
    g=p.split('/')[3]
    if g not in st['bind']: err(404,'CF-ResourceNotFound','binding not found')
    elif hollow(st['bind'][g]['si']): accepted(job('unbind', 1, f"unbind could not be completed: Service broker failed to delete service binding for instance {st['si'][st['bind'][g]['si']]['name']}: Service broker error: failed to get Valkey credentials: failed to get deployment VMs: deployment not found: valkey-cache-small-{st['bind'][g]['si']}"))
    else: del st['bind'][g]; accepted(job('unbind'))
elif p=='/v3/deployments' and method=='POST':
    ag=json.loads(body)['relationships']['app']['data']['guid']; dg='dep-'+uuid.uuid4().hex[:6]
    st['dep'][dg]={'app':ag,'n':0}; st['restarts'][ag]=st['restarts'].get(ag,0)+1; env_snapshot(ag); out={'guid':dg,'status':{'value':'ACTIVE','reason':'DEPLOYING'}}
elif p.startswith('/v3/deployments/'):
    d=st['dep'].get(p.split('/')[3]); d['n']+=1; out={'guid':p.split('/')[3],'status':{'value':'FINALIZED' if d['n']>=1 else 'ACTIVE','reason':'DEPLOYED' if d['n']>=1 else 'DEPLOYING'}}
elif p.startswith('/v3/apps/'):
    parts=p.split('/'); g=parts[3]; a=st['apps'].get(g)
    if not a: err(404,'CF-ResourceNotFound','App not found')
    elif len(parts)==4: out={'guid':g,'name':a['name'],'state':a['state'],'relationships':{'space':{'data':{'guid':a['space']}}}}
    elif p.endswith('/actions/restart'): st['restarts'][g]=st['restarts'].get(g,0)+1; env_snapshot(g); out={'guid':g,'state':'STARTED'}
    elif p.endswith('/processes/web'): out={'guid':g,'instances':INST.get(g,1)}
    elif p.endswith('/processes/web/stats'):
        if os.environ.get('CFFAKE_STATS_FAIL')==g: err(404,'CF-ResourceNotFound','fake: stats unavailable')
        else:
            n=INST.get(g,1); crashed = os.environ.get('CFFAKE_CRASH')==g and st['restarts'].get(g,0)>0
            if g in NAMED and g in st.get('env',{}) and NAMED[g] not in st['env'][g]: crashed=True   # "no credentials found (SIM_SERVICE_NAME=...)"
            def inst_state(i):
                if a['state']!='STARTED': return 'DOWN'
                if g in BROKEN: return 'RUNNING' if i<BROKEN[g] else 'CRASHED'
                return 'CRASHED' if crashed and i==0 else 'RUNNING'
            out=listing([{'index':i,'state':inst_state(i)} for i in range(n)])
    elif p.endswith('/environment_variables'): out={'var':{}}
    else: err(404,'CF-NotFound','fake: unhandled '+p)
else: err(404,'CF-NotFound','fake: unhandled '+method+' '+p)
save(st)
if inc:
    sys.stdout.write(f'HTTP/1.1 {code} X\r\n'+''.join(f'{k}: {v}\r\n' for k,v in hdr.items())+'\r\n')
sys.stdout.write(json.dumps(out) if out is not None else '')
PY
